# Studio server settings
HOST=127.0.0.1
PORT=4173
STUDIO_IDEATE_MODE=auto

# OpenAI provider
# STUDIO_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.2

# OpenAI-compatible chat completions provider
# STUDIO_LLM_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://llm-gateway.example.test/api/v1
# OPENAI_COMPATIBLE_MODEL=provider/model-id

# Local Codex gateway (`npm run codex:gateway` from source; `slideotter codex-gateway` when installed)
# Use the same random token for CODEX_GATEWAY_TOKEN and OPENAI_COMPATIBLE_API_KEY.
# Use the same model for CODEX_GATEWAY_MODEL and OPENAI_COMPATIBLE_MODEL.
# Authenticate this isolated home to a regular file-backed auth.json with:
# CODEX_HOME="$HOME/.slideotter/codex-gateway" codex -c 'cli_auth_credentials_store="file"' login
# Runtime forces HOME, USERPROFILE, and CODEX_HOME to this path; normal ~/.codex and ~/.agents/skills are not inherited.
# Do not add config.toml, requirements.toml, AGENTS.md, AGENTS.override.md, .agents, custom skills, plugins, rules, or hooks.
# The only allowed gateway-home skill directory is Codex-owned skills/.system.
# Vendor-bundled and machine-admin /etc/codex inputs remain trusted.
# CODEX_GATEWAY_TOKEN=
# CODEX_GATEWAY_MODEL=
# CODEX_GATEWAY_CODEX_HOME=~/.slideotter/codex-gateway
# CODEX_GATEWAY_PORT=4174
# CODEX_GATEWAY_REASONING_EFFORT=medium
# CODEX_GATEWAY_TIMEOUT_MS=300000
# CODEX_GATEWAY_MAX_CONCURRENCY=1
# STUDIO_LLM_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:4174
# OPENAI_COMPATIBLE_MODEL=

# LM Studio provider
# STUDIO_LLM_PROVIDER=lmstudio
# LMSTUDIO_MODEL=openai/gpt-oss-20b
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234

# OpenRouter provider
# STUDIO_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o
# Optional OpenRouter app attribution headers
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_APP_TITLE=slideotter

# Shared override for any provider
# STUDIO_LLM_MODEL=
